#!/usr/bin/env bash
# Agent commit wrapper (agent-commit protocol, section 1).
# Injects the agent identity and GPG-signs for this invocation only,
# without touching repository config. Forwards all args to git commit so
# pre-commit hooks run on the normal path. Never pass --no-verify.
set -euo pipefail

AGENT_GIT_NAME="${AGENT_GIT_NAME:-Claude (agent)}"
AGENT_GIT_EMAIL="${AGENT_GIT_EMAIL:-ai@blobfish.icu}"
AGENT_GNUPGHOME="${AGENT_GNUPGHOME:-$HOME/.gnupg}"

for arg in "$@"; do
  case "$arg" in
    --no-verify|-n)
      echo "git-agent-commit: refusing --no-verify (protocol violation)" >&2
      exit 2
      ;;
  esac
done

sign_args=()
if [[ -n "${AGENT_SIGNING_KEY:-}" ]]; then
  sign_args=(-c "user.signingkey=${AGENT_SIGNING_KEY}" -c gpg.program=gpg)
  export GNUPGHOME="$AGENT_GNUPGHOME"
  commit_sign=(--gpg-sign)
elif [[ "${AGENT_REQUIRE_SIGNING:-0}" == "1" ]]; then
  echo "git-agent-commit: AGENT_SIGNING_KEY unset and signing required" >&2
  exit 2
else
  echo "git-agent-commit: AGENT_SIGNING_KEY unset; committing unsigned" >&2
  commit_sign=(--no-gpg-sign)
fi

exec git \
  -c "user.name=${AGENT_GIT_NAME}" \
  -c "user.email=${AGENT_GIT_EMAIL}" \
  "${sign_args[@]}" \
  commit "${commit_sign[@]}" "$@"
